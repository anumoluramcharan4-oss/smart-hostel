# Supabase Postgres Connection String
# Replace [YOUR-PASSWORD] with your actual Supabase database password
# Replace [YOUR-PROJECT-REF] with your Supabase project ref (e.g. uqbgdnfpbvknuelfqdxz)
# Format 1 (Direct connection):
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.uqbgdnfpbvknuelfqdxz.supabase.co:5432/postgres?sslmode=require
# Format 2 (Connection pooler - IPv4 / Transaction pooler port 6543):
# DATABASE_URL=postgresql://postgres.uqbgdnfpbvknuelfqdxz:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
